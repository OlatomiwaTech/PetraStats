
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Season {
  id        String       @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  status    SeasonStatus @default(UPCOMING)

  teams  Team[]
  matches Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate])
}

model Team {
  id        String @id @default(cuid())
  name      String
  shortName String?
  logoUrl   String?

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  players Player[]

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  matchEvents         MatchEvent[] @relation("EventTeam")
  goalkeeperStats     GoalkeeperMatchStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, seasonId])
  @@index([seasonId])
}

model Player {
  id       String         @id @default(cuid())
  name     String
  photoUrl String?
  position PlayerPosition

  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  events       MatchEvent[] @relation("PlayerEvents")
  assistEvents MatchEvent[] @relation("AssistPlayerEvents")

  goalkeeperStats GoalkeeperMatchStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([position])
  @@index([name])
}

model Match {
  id String @id @default(cuid())

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  homeTeamId String
  awayTeamId String

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  status   MatchStatus @default(SCHEDULED)
  playedAt DateTime?

  events MatchEvent[]

  goalkeeperStats GoalkeeperMatchStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([status])
  @@index([playedAt])
}

model MatchEvent {
  id String @id @default(cuid())

  matchId String
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  type MatchEventType
  minute Int?

  /*
   * The team credited with the event.
   *
   * For a normal GOAL:
   * teamId = player's team.
   *
   * For an OWN_GOAL:
   * teamId = the opponent's team.
   */
  teamId String
  team   Team @relation("EventTeam", fields: [teamId], references: [id], onDelete: Cascade)

  /*
   * Player responsible for the event.
   *
   * For GOAL:
   * playerId = goal scorer.
   *
   * For OWN_GOAL:
   * playerId = player who scored the own goal.
   */
  playerId String?
  player   Player? @relation("PlayerEvents", fields: [playerId], references: [id], onDelete: SetNull)

  /*
   * Assister for a normal goal.
   * Should be null for cards and own goals.
   */
  assistPlayerId String?
  assistPlayer   Player? @relation("AssistPlayerEvents", fields: [assistPlayerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
  @@index([assistPlayerId])
  @@index([type])
}

model GoalkeeperMatchStat {
  id String @id @default(cuid())

  matchId String
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  saves Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([teamId])
}
